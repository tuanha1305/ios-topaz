diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 143db60..1879995 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -904,56 +904,87 @@ struct sweet_log_header {
 	uint64_t total, seq;
 };
 
-static void
-sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
+static uint64_t sweet_log_base, sweet_log_flushed, sweet_log_seq;
+
+/* Everything appended since the last flush to the partition. The caller owns the UFS host. */
+static int
+sweet_log_write(void)
 {
-	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
-	uint64_t flushed = 0, seq = 0;
+	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+	uint64_t pos = total - sweet_log_flushed >= SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : sweet_log_flushed;
 	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	int error = 0;
+
+	if (total == sweet_log_flushed) {
+		return 0;
+	}
+	while (pos < total && !error) {
+		uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
+		uint32_t blk = off / UFS_BLOCK;
+		uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+		uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
+		    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+		memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+		error = ufs_write_blocks(sweet_log_base + 1 + blk, n);
+		pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+	}
+	if (!error) {
+		struct sweet_log_header h = {
+			.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+			.version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = ++sweet_log_seq,
+		};
+		bzero(bounce, UFS_BLOCK);
+		memcpy(bounce, &h, sizeof(h));
+		error = ufs_write_blocks(sweet_log_base, 1);
+	}
+	if (!error) {
+		error = ufs_sync_cache();
+	}
+	if (!error) {
+		sweet_log_flushed = total;
+	}
+	return error;
+}
 
+static void
+sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
 	printf("SWEET LOG: console log to the last %u KiB of the partition (block 0x%llx)\n",
-	    SWEET_LOG_BLOCKS * UFS_BLOCK >> 10, base);
+	    SWEET_LOG_BLOCKS * UFS_BLOCK >> 10, sweet_log_base);
 	for (;;) {
 		(void)tsleep(&sweet_log_chan, PZERO, "sweetlog", hz * (int)sweet_log_secs);
-		uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
-		if (total == flushed) {
-			continue;
-		}
-		uint64_t pos = total - flushed >= SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : flushed;
-		int error = 0;
-
 		lck_mtx_lock(&sweet_ufs_lock);
-		while (pos < total && !error) {
-			uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
-			uint32_t blk = off / UFS_BLOCK;
-			uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
-			uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
-			    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
-			memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
-			error = ufs_write_blocks(base + 1 + blk, n);
-			pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
-		}
-		if (!error) {
-			struct sweet_log_header h = {
-				.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
-				.version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = ++seq,
-			};
-			bzero(bounce, UFS_BLOCK);
-			memcpy(bounce, &h, sizeof(h));
-			error = ufs_write_blocks(base, 1);
-		}
-		if (!error) {
-			error = ufs_sync_cache();
-		}
+		int error = sweet_log_write();
 		lck_mtx_unlock(&sweet_ufs_lock);
 		if (error) {
 			printf("SWEET LOG: write failed (%d), stopping\n", error);
+			sweet_log_base = 0;
 			return;
 		}
-		flushed = total;
 	}
 }
 
+/*
+ * spes: the panic itself (and its backtraces, which go to the panic buffer only) to the
+ * partition, from SavePanicInfo: the other CPUs are stopped, the host is polled. Once.
+ */
+void sweet_log_panic_flush(const char *text, unsigned len);
+void
+sweet_log_panic_flush(const char *text, unsigned len)
+{
+	static int done;
+
+	if (done++ || sweet_log_base == 0) {
+		return;
+	}
+	static const char mark[] = "\n==== SWEET LOG: panic buffer ====\n";
+	sweet_log_append(mark, sizeof(mark) - 1);
+	if (text != NULL && len != 0) {
+		sweet_log_append(text, (int)MIN(len, (unsigned)SWEET_LOG_SIZE / 2));
+	}
+	(void)sweet_log_write();
+}
+
 static void
 sweet_log_start(void)
 {
@@ -968,6 +999,7 @@ sweet_log_start(void)
 	if (sweet_log_secs == 0 || sweet_log_secs > 60) {
 		sweet_log_secs = SWEET_LOG_SECS;
 	}
+	sweet_log_base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
 	if (kernel_thread_start(sweet_log_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
